diff --git a/harness/engine/engine.go b/harness/engine/engine.go
index ce1368b..b384091 100644
--- a/harness/engine/engine.go
+++ b/harness/engine/engine.go
@@ -30,10 +30,12 @@ func New(name string) (Engine, error) {
 	switch strings.ToLower(name) {
 	case "pdfkit", "go-pdfkit":
 		return PDFKit{}, nil
+	case "pdfkit-stilus":
+		return PDFKit{Sparse: true}, nil
 	case "pdfium":
 		return NewPDFium()
 	case "stilus":
 		return Stilus{}, nil
 	}
-	return nil, fmt.Errorf("unknown engine %q (pdfkit, pdfium, stilus)", name)
+	return nil, fmt.Errorf("unknown engine %q (pdfkit, pdfkit-stilus, pdfium, stilus)", name)
